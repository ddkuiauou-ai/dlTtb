{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Choose the actual account/Worker name before the first manual deployment.
  // No production custom-domain route is configured during the local upgrade.
  "name": "silla-is",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
